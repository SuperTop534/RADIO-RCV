# ============================================================
# RCV Estúdio Rádio — variáveis de ambiente (exemplo)
# Copie para ".env" e preencha. NUNCA publique o arquivo .env.
# ============================================================

# Porta do servidor (provedores como Render/Railway definem PORT sozinhos)
PORT=8080

# URL pública do site, sem barra no final (necessária para as
# notificações instantâneas do YouTube via WebSub/PubSubHubbub).
# Ex.: https://app.rcvestudioradio.com.br
PUBLIC_URL=

# --- YouTube --------------------------------------------------
# Chave da YouTube Data API v3 (Google Cloud Console). Fica SOMENTE no servidor.
# Sem ela o app funciona: mostra os vídeos pelo feed público do canal e
# avisa que a verificação de transmissão ao vivo está indisponível.
YOUTUBE_API_KEY=

# ID do canal @rcvestudioradio4570
YOUTUBE_CHANNEL_ID=UCUhM7X3log3z56SWCoEWgSg

# Verificação diária obrigatória (fuso de Brasília)
LIVE_DAILY_CHECK_TIME=18:00
TIMEZONE=America/Sao_Paulo

# Verificação periódica de segurança no servidor (minutos).
# Cada verificação com chave consome ~3 unidades de cota (cota diária padrão: 10.000).
LIVE_POLL_MINUTES=10

# Intervalo de consulta do app aberto ao servidor (segundos). Não consome cota
# do YouTube: o app só lê o cache do servidor.
CLIENT_POLL_SECONDS=60

# Quantidade de vídeos exibidos
YOUTUBE_MAX_VIDEOS=12

# Segredo (qualquer texto longo aleatório) para validar as notificações WebSub
WEBSUB_SECRET=

# --- Rádio ----------------------------------------------------
RADIO_STREAM_URL=https://stm12.voxhd.com.br:13010/stream//

# --- WhatsApp -------------------------------------------------
WHATSAPP_NUMBER=5543984195925

# --- Agendador externo (opcional) -----------------------------
# Se a hospedagem "dorme" (planos gratuitos), configure um serviço como
# cron-job.org para chamar às 18:00 (America/Sao_Paulo):
#   POST https://SEU-DOMINIO/api/youtube/check   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Pasta do cache do YouTube (padrão: ./data)
# DATA_DIR=data
